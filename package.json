{
  "name": "git-training",
  "version": "0.1.0",
  "description": "Luyện Git offline qua 116 bài thực hành tiếng Việt",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "git-training": "./bin/git-training.cjs" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["bin", "dist", "docs", "theory", "!theory/src", "!theory/examples", "!theory/build.mjs", "!theory/check.mjs", "!theory/lib.mjs", "!theory/vendor", "!theory/README.md", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "keywords": ["git", "training", "learning", "cli", "exercises"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Duy247/git-training.git" },
  "homepage": "https://github.com/Duy247/git-training#readme",
  "bugs": { "url": "https://github.com/Duy247/git-training/issues" },
  "publishConfig": { "access": "public" }
}
