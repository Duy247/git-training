{
  "name": "@duy247/git-training",
  "version": "0.5.0",
  "description": "Luyện Git offline qua 116 bài thực hành tiếng Việt, có bảng học trên trình duyệt",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "git-training": "./bin/git-training.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "web",
    "theory",
    "!theory/src",
    "!theory/examples",
    "!theory/build.mjs",
    "!theory/check.mjs",
    "!theory/lib.mjs",
    "!theory/vendor",
    "!theory/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:css": "tailwindcss -i web-src/input.css -o web/app.css --minify",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build:css && npm test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "git",
    "training",
    "learning",
    "cli",
    "exercises"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Duy247/git-training.git"
  },
  "homepage": "https://github.com/Duy247/git-training#readme",
  "bugs": {
    "url": "https://github.com/Duy247/git-training/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
