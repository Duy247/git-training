{
  "name": "git-training",
  "version": "0.1.0",
  "description": "Luyện Git offline qua 116 bài thực hành tiếng Việt",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "git-training": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
